# Copy to .env with scripts/setup-env.ps1 (it generates the secrets for you).
# Never commit .env.

# --- PostgreSQL (docker compose, bound to 127.0.0.1 only) ---
POSTGRES_USER=qai
POSTGRES_PASSWORD=change-me-generated-by-setup-env
POSTGRES_DB=qai
# Host port 55432 avoids clashing with a PostgreSQL already installed on Windows (5432).
POSTGRES_PORT=55432

# --- Backend ---
QAI_DATABASE_URL=postgresql+psycopg://qai:change-me-generated-by-setup-env@127.0.0.1:55432/qai
QAI_TEST_DATABASE_URL=postgresql+psycopg://qai:change-me-generated-by-setup-env@127.0.0.1:55432/qai_test
# Bearer token required on every /api request. The Next.js server injects it; browsers never see it.
QAI_API_TOKEN=change-me-generated-by-setup-env
QAI_DATA_DIR=./data
QAI_API_HOST=127.0.0.1
QAI_API_PORT=8000
QAI_LOG_LEVEL=INFO

# --- Local AI (free) ---
QAI_OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional paid AI providers (disabled unless explicitly approved in AI Model Settings) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Frontend (server-side only) ---
QAI_BACKEND_URL=http://127.0.0.1:8000
